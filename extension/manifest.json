{
  "manifest_version": 3,
  "name": "MRY Jet Center Alert",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "Local advisory notifications for aircraft going to Monterey Jet Center.",
  "permissions": ["activeTab", "notifications", "offscreen", "storage", "tabCapture"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {"service_worker": "background.js"},
  "action": {
    "default_popup": "popup.html",
    "default_title": "MRY Jet Center Alert",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
